# Generated automatically by deploy.sh on first run (as ./.env, chmod 600).
# SQL Server 'sa' password. Must meet complexity: upper+lower+digit+special, 8+ chars.
SA_PASSWORD=change-me-Strong#Pass1

# Auth JWT signing secret. Auto-generated by deploy.sh if left unset.
JWT_SIGNING_KEY=change-me-64-hex-chars

# --- Sign-in providers (optional) ------------------------------------------------
# Google OAuth web client id (Google Cloud Console -> APIs & Services -> Credentials).
# Leave blank to disable Google sign-in server-side validation.
GOOGLE_WEB_CLIENT_ID=

# Apple Sign-In bundle id (matches the iOS app's bundle identifier / Services ID).
APPLE_BUNDLE_ID=com.nikolapetrovski.silafit

# --- OpenRouter (optional) -------------------------------------------------------
# Powers the AI-narrated progress analytics text. Leave blank to disable — the
# service falls back gracefully with no external LLM call attempted.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1

# --- SMTP (optional) -------------------------------------------------------------
# Transactional email: registration verification codes and the monthly progress
# emails. Leave SMTP_HOST blank to disable outbound email (the monthly batch then
# generates + stores reports without sending them).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=SilaFit

# --- App Store / Play Store review account (optional) -----------------------------
# When both are set, registering with REVIEWER_BYPASS_EMAIL gets this fixed code
# instead of a random emailed one, so App Store / Play Store reviewers can sign
# in without inbox access. Leave both blank outside of an active review.
REVIEWER_BYPASS_EMAIL=
REVIEWER_BYPASS_CODE=

# --- Monthly review batch (optional) ---------------------------------------------
# Runs on the 1st of each month for the previous month; see the
# "Monthly progress emails" section in this directory's README.md.
# MONTHLY_REVIEW_PLAN_CODE=ADVANCED
# MONTHLY_REVIEW_SEND_EMAILS=true
# Second pass for non-paying users (stats teaser + upgrade CTA, no AI cost):
# MONTHLY_REVIEW_SEND_UPSELL_EMAILS=true
# MONTHLY_REVIEW_UPSELL_MIN_TRACKED_UNITS=1
# MONTHLY_REVIEW_UPGRADE_URL=https://sila.fitness/#pricing

# --- Push reminders (optional) ---------------------------------------------------
# Frequent (every 5 minutes) notification batch; see the "Push reminders" section
# in this directory's README.md. The batch composes and records reminders even
# when push is off; enable delivery by dropping your Firebase service-account JSON
# at deploy/secrets/fcm-service-account.json and setting PUSH_ENABLED=true.
# PUSH_ENABLED=false
# PUSH_PROJECT_ID=your-firebase-project-id
# PUSH_SERVICE_ACCOUNT_PATH=/secrets/fcm-service-account.json
# Set to true to host the publisher inside the API instead of the cron entry:
# NOTIFICATION_RUN_IN_API=false
# NOTIFICATION_PUBLISH_ENABLED=true
# Monthly "unlock your review" push to non-paying users, on the 1st at 09:00 local:
# NOTIFICATION_MONTHLY_UPSELL_ENABLED=true
# NOTIFICATION_MONTHLY_UPSELL_DAY=1
# NOTIFICATION_MONTHLY_UPSELL_TIME=09:00

# --- In-app purchases: store receipt verification (optional) ---------------------
# Powers the verify-purchase endpoint, the Apple/Google store webhooks, and the
# silen-subscription-sync reconciliation batch (every 4 hours). Leave unset and
# purchases cannot be verified server-side - see deploy/README.md.
#
# App Store Server API: KeyId + IssuerId come from the key you generate in App
# Store Connect (Users and Access > Integrations > In-App Purchase); drop the
# downloaded .p8 at deploy/secrets/appstore-server-key.p8.
# APP_STORE_SERVER_KEY_ID=your-key-id
# APP_STORE_SERVER_ISSUER_ID=your-issuer-id
# APP_STORE_SERVER_BUNDLE_ID=com.nikolapetrovski.silafit
# APP_STORE_SERVER_PRIVATE_KEY_PATH=/secrets/appstore-server-key.p8
# Sandbox while testing, Production once live:
# APP_STORE_SERVER_ENVIRONMENT=Production
#
# Play Developer API: service account needs "View financial data" + Play
# Developer API access in Play Console; drop its downloaded JSON key at
# deploy/secrets/play-service-account.json.
# GOOGLE_PLAY_PACKAGE_NAME=com.nikolapetrovski.silafit
# GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=/secrets/play-service-account.json

# --- Resource limits (optional overrides) ----------------------------------------
# MSSQL_MEMORY_LIMIT_MB=2048
# DB_MEM_LIMIT=2560m
# API_MEM_LIMIT=1024m
# DB_PORT=14340
# API_PORT=5010
