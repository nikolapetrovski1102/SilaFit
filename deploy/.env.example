# Generated automatically by deploy.sh on first run (as ./.env, chmod 600).
# SQL Server 'sa' password. Must meet complexity: upper+lower+digit+special, 8+ chars.
SA_PASSWORD=change-me-Strong#Pass1

# Auth JWT signing secret. Auto-generated by deploy.sh if left unset.
JWT_SIGNING_KEY=change-me-64-hex-chars

# --- Sign-in providers (optional) ------------------------------------------------
# Google OAuth web client id (Google Cloud Console -> APIs & Services -> Credentials).
# Leave blank to disable Google sign-in server-side validation.
GOOGLE_WEB_CLIENT_ID=

# Apple Sign-In bundle id (matches the iOS app's bundle identifier / Services ID).
APPLE_BUNDLE_ID=com.nikolapetrovski.silafit

# --- OpenRouter (optional) -------------------------------------------------------
# Powers the AI-narrated progress analytics text. Leave blank to disable — the
# service falls back gracefully with no external LLM call attempted.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1

# --- Resource limits (optional overrides) ----------------------------------------
# MSSQL_MEMORY_LIMIT_MB=2048
# DB_MEM_LIMIT=2560m
# API_MEM_LIMIT=1024m
# DB_PORT=14340
# API_PORT=5010
