# macOS
.DS_Store

# Visual Studio / VS for Mac
.vs/

# .NET / backend
backend/**/bin/
backend/**/obj/
*.user

# SQL Server data volume mounts (docker-compose uses a named volume, not a bind mount, but just in case)
database/**/*.mdf
database/**/*.ldf

# Environment/secrets
.env
*.local.json

# Local dev config with real connection strings & keys — never commit
backend/src/Silen.Api/appsettings.Development.json

# Old/local deploy scripts with hardcoded dev passwords — superseded by deploy/deploy.sh
database/scripts/

# TDE certificate + private key backup — losing it permanently locks the
# encrypted database; never commit it, move it to separate secure storage.
deploy/tde-cert-backup/

# Android signing keystore backup - never commit
*.jks
*.keystore
