<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Silen.Common\Silen.Common.csproj" />
    <ProjectReference Include="..\Silen.Data\Silen.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Renders the authenticator enrollment URI as a terminal QR in the read-only
         reveal mode. Local-only, in-process: the URI carries the raw TOTP secret,
         so it must never be handed to a remote QR service (same reason the console
         uses a vendored qrcode.js instead of a CDN). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Microsoft.Data.SqlClient requires ICU/globalization to open a connection;
         invariant mode throws NotSupportedException on TryOpen. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Store DateTime/DateOnly.MinValue as 0001-01-01, the way SQL Server did,
         instead of Npgsql's default mapping to -infinity. -->
    <RuntimeHostConfigurationOption Include="Npgsql.DisableDateTimeInfinityConversions" Value="true" />
  </ItemGroup>

</Project>
